# Copy this file to .env and fill in what you need. Never commit .env.

# --- Databases (defaults match docker-compose.yml) ---
POSTGRES_URL=postgresql+psycopg://plangraph:plangraph@localhost:5432/plangraph
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=plangraph-dev

# --- LLM (optional). Without a key the app runs in offline mode:
# alerts, graph and targets work; the Ask page uses keyword routing instead of an LLM.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Simulation ---
# The "today" of the simulated company, as YYYY-MM-DD. Empty = the real today.
AS_OF=

# --- UI ---
API_URL=http://localhost:8000
